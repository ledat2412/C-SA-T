# Shared ignores for all projects in this repository

# Build output
**/bin/
**/obj/
_temp_build/
**/bin_verify*/
**/tempobj*/
**/tempbuild*/

# IDE / user-local files
**/.vs/
**/*.user
**/*.suo

# Local secret props
**/Secrets.props
**/Secret.props
**/Secret/props.txt
**/*.keystore

# App secret folders
**/Secret/*.json
!**/Secret/*.example.json
CS_admin/Secret/google-maps-browser-key.txt

# Local development settings with secrets
VinhKhanh/VinhKhanh/appsettings.Development.json
!VinhKhanh/VinhKhanh/appsettings.Development.example.json

# Service account credentials
**/Credentials/service-account.json
**/bin/**/Credentials/service-account.json

**/.claude/

# Runtime logs – never commit
CS_admin/logs/
VinhKhanh/VinhKhanh/Logs/
VinhKhanh/VinhKhanh/temp_*.log
**/hs_err_pid*.log
**/replay_pid*.log
**/temp_*.log
